# FastAPI origin baked into the APK at build time (no trailing slash, no /api).
# The Android app defaults to the live Render API if this is unset:
#   https://budgeting-app-m3aj.onrender.com
#
# Only set this to override that default, e.g. a local API while developing:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
