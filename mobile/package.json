{
  "name": "setaside-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "dependencies": {
    "expo": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "android": "expo run:android --variant release",
    "prebuild": "expo prebuild --platform android",
    "studio-setup": "bash ./scripts/setup-android-studio.sh",
