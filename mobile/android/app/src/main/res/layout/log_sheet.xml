<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/log_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false">

    <View
        android:id="@+id/log_sheet_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#6614231c"
        android:contentDescription="@string/log_sheet_close" />

    <FrameLayout
        android:id="@+id/log_sheet_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/log_sheet_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:background="@drawable/log_sheet_card"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/log_sheet_handle" />

            <TextView
                android:id="@+id/log_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#14231c"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/log_sheet_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#8b2e2e"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/log_sheet_category"
                android:textColor="#5f7368"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/log_sheet_category_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/log_sheet_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    android:id="@+id/log_sheet_category_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/log_sheet_choose"
                    android:textColor="#5f7368"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:text="▾"
                    android:textColor="#5f7368"
                    android:textSize="16sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/log_sheet_categories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/log_sheet_field"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/log_sheet_category_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/log_sheet_amount"
                android:textColor="#5f7368"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/log_sheet_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/log_sheet_field"
                android:hint="0.00"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="52dp"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:textColor="#14231c"
                android:textColorHint="#5f7368"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/log_sheet_date"
                android:textColor="#5f7368"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/log_sheet_prev_day"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/log_sheet_field"
                    android:contentDescription="@string/log_sheet_prev_day"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#14231c"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/log_sheet_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#14231c"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/log_sheet_today_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_sheet_today"
                        android:textColor="#5f7368"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/log_sheet_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_sheet_today"
                        android:textColor="#1f4b3a"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/log_sheet_next_day"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/log_sheet_field"
                    android:contentDescription="@string/log_sheet_next_day"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#14231c"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/log_sheet_note"
                android:textColor="#5f7368"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/log_sheet_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/log_sheet_field"
                android:hint="@string/log_sheet_note_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:textColor="#14231c"
                android:textColorHint="#5f7368"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/log_sheet_withdraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#1f4b3a"
                android:textColor="#14231c"
                android:visibility="gone" />

            <TextView
                android:id="@+id/log_sheet_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/log_sheet_save"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
