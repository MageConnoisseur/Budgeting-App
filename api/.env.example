# Neon / Postgres connection string (pooled URL is fine for the app)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional direct (non-pooled) URL for migrations if needed
# DATABASE_URL_DIRECT=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret — generate a long random string for production
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated CORS origins (local Vite + any custom domains).
# https://*.vercel.app is always allowed in code — still list custom domains here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public URLs (no trailing slash) used for OAuth redirects
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# Google OAuth (optional — leave blank to hide Google buttons)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {API_PUBLIC_URL}/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Facebook Login (optional)
# Create an app at https://developers.facebook.com/
# Valid OAuth Redirect URI: {API_PUBLIC_URL}/api/auth/oauth/facebook/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Local-only fake OAuth provider for demos/tests (never enable in production)
# OAUTH_DEV_MODE=true

# Optional: access token lifetime in minutes (default 10080 = 7 days)
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Password reset / email confirmation link lifetime (default 60 minutes)
# PASSWORD_RESET_EXPIRE_MINUTES=60

# SMTP for recovery emails. Leave SMTP_HOST blank to log messages instead of sending
# (local/dev). Production should set a real mail host so Forgot password works.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Hearth Budgeting <noreply@example.com>
# SMTP_USE_TLS=true
