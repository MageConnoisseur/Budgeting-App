# Copy to .env and fill in values from Neon (or run neon.new provisioning).
# Never commit real secrets.

# Pooled connection (app queries)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require

# Direct connection (preferred for schema apply / migrations)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional: claim URL if using a claimable neon.new database
# PUBLIC_POSTGRES_CLAIM_URL=https://neon.new/claim/...
